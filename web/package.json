{
  "name": "hades-listening",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "dev": "npm run prepare:data && vite --config vite.config.ts --host 0.0.0.0",
    "test": "vitest run --config vite.config.ts",
    "build": "npm run prepare:data && tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.2",
    "preact": "^10.26.9"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
